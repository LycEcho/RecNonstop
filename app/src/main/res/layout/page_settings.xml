<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/pageSettings"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="16dp"
        android:paddingRight="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="设置"
            android:textSize="30sp"
            android:textColor="@color/text_primary"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="按你的习惯，让记录更顺手"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:includeFontPadding="false"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="采集与保存"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:accessibilityHeading="true"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="@android:color/transparent">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="打开即录音"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="进入 App 后自动开始"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:includeFontPadding="false"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <Switch
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:id="@+id/swAutoStart"
                    style="@style/AppSwitch"
                    android:contentDescription="打开即录音"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/rowQuality"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="录音质量"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/tvQualitySub"
                        android:text="下一段开始生效"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:includeFontPadding="false"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvQualityValue"
                    android:text="省空间"
                    android:textSize="13sp"
                    android:textColor="@color/brand"
                    android:includeFontPadding="false"
                    android:layout_marginStart="12dp"
                    android:maxWidth="104dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:gravity="end" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron"
                    android:tint="@color/text_tertiary"
                    android:contentDescription="@null"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/rowSegment"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="分段时长"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/tvSegmentSub"
                        android:text="下一段开始生效"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:includeFontPadding="false"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvSegmentValue"
                    android:text="3 分钟"
                    android:textSize="13sp"
                    android:textColor="@color/brand"
                    android:includeFontPadding="false"
                    android:layout_marginStart="12dp"
                    android:maxWidth="104dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:gravity="end" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron"
                    android:tint="@color/text_tertiary"
                    android:contentDescription="@null"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/rowKeep"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="保留时间"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/tvKeepSub"
                        android:text="到期自动清理旧录音"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:includeFontPadding="false"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvKeepValue"
                    android:text="7 天"
                    android:textSize="13sp"
                    android:textColor="@color/brand"
                    android:includeFontPadding="false"
                    android:layout_marginStart="12dp"
                    android:maxWidth="104dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:gravity="end" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron"
                    android:tint="@color/text_tertiary"
                    android:contentDescription="@null"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="整理成日报"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:accessibilityHeading="true"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="@android:color/transparent">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="每日自动生成"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/tvReportSettingSub"
                        android:text="由已连接的电脑生成"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:includeFontPadding="false"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <Switch
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:id="@+id/swDailyReport"
                    style="@style/AppSwitch"
                    android:contentDescription="每日自动生成"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/rowReportTime"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="生成时间"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="使用电脑的本地时间"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:includeFontPadding="false"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvReportTimeValue"
                    android:text="18:00"
                    android:textSize="13sp"
                    android:textColor="@color/brand"
                    android:includeFontPadding="false"
                    android:layout_marginStart="12dp"
                    android:maxWidth="104dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:gravity="end" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron"
                    android:tint="@color/text_tertiary"
                    android:contentDescription="@null"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="后台与屏幕"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:accessibilityHeading="true"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="@android:color/transparent">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="自动恢复录音"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="被系统中断后尝试恢复"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:includeFontPadding="false"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <Switch
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:id="@+id/swWatchdog"
                    style="@style/AppSwitch"
                    android:contentDescription="自动恢复录音"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/rowBattery"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="允许后台运行"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="检查电池优化限制"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:includeFontPadding="false"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvBatteryValue"
                    android:text="未加入"
                    android:textSize="13sp"
                    android:textColor="@color/brand"
                    android:includeFontPadding="false"
                    android:layout_marginStart="12dp"
                    android:maxWidth="104dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:gravity="end" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron"
                    android:tint="@color/text_tertiary"
                    android:contentDescription="@null"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/rowAutostart"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="系统自启动"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="查看手机的后台管理设置"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:includeFontPadding="false"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron"
                    android:tint="@color/text_tertiary"
                    android:contentDescription="@null"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/rowTimeout"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="系统息屏时间"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvTimeoutValue"
                    android:text="1 分钟"
                    android:textSize="13sp"
                    android:textColor="@color/brand"
                    android:includeFontPadding="false"
                    android:layout_marginStart="12dp"
                    android:maxWidth="104dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:gravity="end" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron"
                    android:tint="@color/text_tertiary"
                    android:contentDescription="@null"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="@android:color/transparent">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="单独调节 App 亮度"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="不改变系统亮度"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:includeFontPadding="false"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <Switch
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:id="@+id/swBright"
                    style="@style/AppSwitch"
                    android:contentDescription="单独调节 App 亮度"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/brightnessPanel"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="12dp">

                <SeekBar
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:id="@+id/sbBright"
                    android:layout_weight="1"
                    android:max="99"
                    android:progressBackgroundTint="@color/divider"
                    android:progressTint="@color/brand"
                    android:thumbTint="@color/brand"
                    android:contentDescription="App 亮度" />

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvBrightValue"
                    android:text="1%"
                    android:textSize="13sp"
                    android:textColor="@color/brand"
                    android:includeFontPadding="false"
                    android:gravity="end" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="存储与帮助"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:accessibilityHeading="true"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/rowPath"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="录音保存位置"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="查看并复制路径"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:includeFontPadding="false"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron"
                    android:tint="@color/text_tertiary"
                    android:contentDescription="@null"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/rowDiag"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="导出诊断日志"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="帮助排查录音异常"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:includeFontPadding="false"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron"
                    android:tint="@color/text_tertiary"
                    android:contentDescription="@null"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/tvVersion"
            android:text="录不停"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:includeFontPadding="false"
            android:layout_marginTop="28dp"
            android:gravity="center" />
    </LinearLayout>
</ScrollView>
