<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/pageComputer"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="16dp"
        android:paddingRight="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="连接电脑"
            android:textSize="30sp"
            android:textColor="@color/text_primary"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="同步录音，获取转写与日报"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:includeFontPadding="false"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="22dp"
            android:layout_marginTop="26dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_summary">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_pc"
                        android:tint="@color/brand"
                        android:contentDescription="@null" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvPcBadge"
                    android:text="未连接"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:includeFontPadding="false"
                    android:background="@drawable/bg_chip_gray"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_marginStart="14dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/tvPcTitle"
                android:text="未连接电脑"
                android:textSize="23sp"
                android:textColor="@color/text_primary"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="20dp"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/tvPcSub"
                android:text="连接后自动同步已保存的录音"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:includeFontPadding="false"
                android:layout_marginTop="8dp"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/tvPcStatus"
                android:text="手机与电脑连接同一网络后，查找并确认你的电脑。"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:includeFontPadding="false"
                android:layout_marginTop="20dp"
                android:lineSpacingExtra="5dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/tvPcStats"
                android:text="已上传 0 段 · 待上传 0 段"
                android:textSize="12sp"
                android:textColor="@color/brand"
                android:includeFontPadding="false"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="3dp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/tvPcSummary"
                android:text=""
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:includeFontPadding="false"
                android:layout_marginTop="16dp"
                android:padding="14dp"
                android:background="@drawable/bg_summary"
                android:lineSpacingExtra="4dp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/btnPcAction"
                android:text="发现电脑"
                android:textSize="15sp"
                android:textColor="@color/white"
                android:includeFontPadding="false"
                android:gravity="center"
                android:background="@drawable/bg_button_primary"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="24dp"
                android:minHeight="52dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:accessibilityLiveRegion="polite" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/btnManualPair"
                android:text="手动输入电脑地址"
                android:textSize="13sp"
                android:textColor="@color/brand"
                android:includeFontPadding="false"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_ripple_transparent"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:accessibilityLiveRegion="polite" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="同步方式"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:accessibilityHeading="true"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="@android:color/transparent">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="自动同步"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="每段保存后上传，离线后自动补传"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:includeFontPadding="false"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <Switch
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:id="@+id/swUpload"
                    style="@style/AppSwitch"
                    android:contentDescription="自动同步"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="@android:color/transparent">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="仅使用 Wi-Fi"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="连接 Wi-Fi 后再上传"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:includeFontPadding="false"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <Switch
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:id="@+id/swWifiOnly"
                    style="@style/AppSwitch"
                    android:contentDescription="仅使用 Wi-Fi"
                    android:layout_marginStart="12dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="管理连接"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:accessibilityHeading="true"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/rowTestPc"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="检查连接"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron"
                    android:tint="@color/text_tertiary"
                    android:contentDescription="@null"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/rowRediscover"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="更换电脑"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron"
                    android:tint="@color/text_tertiary"
                    android:contentDescription="@null"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/rowUnpair"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="解除连接"
                        android:textSize="15sp"
                        android:textColor="@color/danger"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="手机上的录音仍然保留"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:includeFontPadding="false"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron"
                    android:tint="@color/text_tertiary"
                    android:contentDescription="@null"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="电脑分析可选。关闭同步后，手机仍可独立录音。"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:includeFontPadding="false"
            android:layout_marginTop="20dp"
            android:lineSpacingExtra="4dp" />
    </LinearLayout>
</ScrollView>
