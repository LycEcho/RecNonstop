<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/pageFiles"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="16dp"
        android:paddingRight="20dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="记录"
                android:textSize="30sp"
                android:textColor="@color/text_primary"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:accessibilityHeading="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/btnCleanupFiles"
                android:text="清理"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:includeFontPadding="false"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_ripple_transparent"
                android:minHeight="48dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:minWidth="56dp"
                android:maxLines="1"
                android:accessibilityLiveRegion="polite" />

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:id="@+id/btnRefreshFiles"
                android:background="@drawable/bg_ripple_transparent"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="刷新记录">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_refresh"
                    android:tint="@color/text_primary"
                    android:contentDescription="@null" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/tvFilesSummary"
            android:text="正在读取录音…"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:includeFontPadding="false"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:scrollbars="none"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:id="@+id/filterAll"
                    android:text="全部"
                    android:textSize="13sp"
                    android:textColor="@color/filter_text"
                    android:includeFontPadding="false"
                    android:background="@drawable/bg_filter_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="18dp"
                    android:paddingRight="18dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:id="@+id/filterToday"
                    android:text="今天"
                    android:textSize="13sp"
                    android:textColor="@color/filter_text"
                    android:includeFontPadding="false"
                    android:background="@drawable/bg_filter_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="18dp"
                    android:paddingRight="18dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:id="@+id/filterPending"
                    android:text="未上传"
                    android:textSize="13sp"
                    android:textColor="@color/filter_text"
                    android:includeFontPadding="false"
                    android:background="@drawable/bg_filter_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="18dp"
                    android:paddingRight="18dp"
                    android:layout_marginEnd="8dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/tvFilesRecordingHint"
            android:text="正在录制的片段保存后会出现在这里"
            android:textSize="12sp"
            android:textColor="@color/brand"
            android:includeFontPadding="false"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_summary"
            android:padding="14dp"
            android:lineSpacingExtra="3dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/filesContainer"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:clipToOutline="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/btnLoadMore"
            android:text="继续查看"
            android:textSize="15sp"
            android:textColor="@color/brand"
            android:includeFontPadding="false"
            android:gravity="center"
            android:background="@drawable/bg_button_secondary"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:minHeight="48dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:accessibilityLiveRegion="polite" />
    </LinearLayout>
</ScrollView>
