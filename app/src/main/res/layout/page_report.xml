<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/pageReport"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="16dp"
        android:paddingRight="20dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="日报"
                android:textSize="30sp"
                android:textColor="@color/text_primary"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:accessibilityHeading="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/btnReportRefresh"
                android:text="同步"
                android:textSize="13sp"
                android:textColor="@color/brand"
                android:includeFontPadding="false"
                android:gravity="center"
                android:background="@drawable/bg_button_secondary"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="48dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:minWidth="76dp"
                android:maxLines="1"
                android:accessibilityLiveRegion="polite" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="按天回顾重点、待办与对话"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:includeFontPadding="false"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="选择日期"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:includeFontPadding="false"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="10dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/reportChips"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="22dp"
            android:layout_marginTop="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="每日归档"
                android:textSize="11sp"
                android:textColor="@color/brand"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/tvReportTitle"
                android:text="还没有日报"
                android:textSize="24sp"
                android:textColor="@color/text_primary"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="3dp"
                android:accessibilityHeading="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/tvReportMeta"
                android:text="连接电脑后自动接收"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:includeFontPadding="false"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="5dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/tvReportEmpty"
                android:text="每一天的录音，可以在这里成为一份清晰的回顾。&#10;连接电脑后，日报会自动同步。"
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                android:includeFontPadding="false"
                android:paddingTop="18dp"
                android:paddingBottom="26dp"
                android:lineSpacingExtra="7dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/tvReportContent"
                android:text=""
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:includeFontPadding="false"
                android:lineSpacingExtra="7dp"
                android:textIsSelectable="true"
                android:breakStrategy="high_quality"
                android:maxLines="14"
                android:ellipsize="end"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/btnReportDetail"
                android:text="阅读完整日报"
                android:textSize="15sp"
                android:textColor="@color/white"
                android:includeFontPadding="false"
                android:gravity="center"
                android:background="@drawable/bg_button_primary"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="24dp"
                android:visibility="gone"
                android:minHeight="52dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:accessibilityLiveRegion="polite" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="已下载的日报，无需联网也能阅读"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:includeFontPadding="false"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>
</ScrollView>
