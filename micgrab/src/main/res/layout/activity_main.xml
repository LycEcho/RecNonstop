<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F7F8FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="麦克风占用测试"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#111111" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="常驻占用麦克风，用来测别的录音 App 会怎样"
            android:textSize="13sp"
            android:textColor="#888888" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:textColor="#222222"
            android:text="状态：未占用" />

        <Switch
            android:id="@+id/swCallMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="52dp"
            android:text="同时切到通话模式（模拟微信语音）"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="开始占用麦克风"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="停止占用"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="说明"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#333333" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:textSize="13sp"
            android:textColor="#444444"
            android:lineSpacingExtra="4dp"
            android:text="1. 先打开「录不停」，让它开始录音\n2. 回到本 App，点「开始占用麦克风」\n3. 观察录不停的日志和录音文件\n4. 勾选通话模式，可以模拟微信语音通话那种抢占\n5. 点「停止占用」，看录不停能否自动恢复" />

    </LinearLayout>
</ScrollView>
